{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "127",
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "permissions": [
    "bookmarks",
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "contextMenus",
    "favicon",
    "sidePanel"
  ],
  "optional_permissions": [
    "identity",
    "history"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "__MSG_openSidebar__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https: http:"
  },
  "commands": {
    "search-bookmarks": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "__MSG_searchCommand__"
    },
    "save-current-page": {
      "description": "__MSG_savePage__"
    }
  },
  "omnibox": {
    "keyword": "zl"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel/index.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "default_locale": "zh_CN",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
