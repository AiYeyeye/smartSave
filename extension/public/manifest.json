{
  "manifest_version": 3,
  "name": "智栏 · 书签助手",
  "version": "0.1.0",
  "description": "原生书签助手：点击工具栏从左侧弹出书签侧栏，点空白处收起；选项页为完整工作台。",
  "minimum_chrome_version": "116",
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "permissions": [
    "bookmarks",
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "favicon",
    "sidePanel"
  ],
  "optional_permissions": [
    "identity"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "打开智栏书签侧栏"
  },
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https: http:"
  },
  "commands": {
    "save-current-page": {
      "description": "Save current page with Zhilan"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel/index.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
